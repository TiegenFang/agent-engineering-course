---
const lessonId = "t23-research-capstone";
---

<section class="research-capstone-lab" data-research-capstone aria-labelledby="research-capstone-title">
  <div class="research-capstone-lab__intro">
    <p class="eyebrow">离线研究工作台 · {lessonId}</p>
    <h2 id="research-capstone-title">把一次分析交付成可复现实验</h2>
    <p>
      先选择输入与故障，再观察上下文、Memory、Skill、MCP 边界和交付物是否完整。
      这里的状态是确定性教学夹具，不会调用模型、网络、真实研究数据或外部工具。
    </p>
  </div>

  <div class="research-capstone-lab__controls" aria-label="实验输入">
    <fieldset>
      <legend>变化输入</legend>
      <label><input type="radio" name="research-input" value="temperature-daily" checked /> 日间温度（°C，最近 5 条）</label>
      <label><input type="radio" name="research-input" value="pressure-night" /> 夜班压力（kPa，最近 3 条）</label>
    </fieldset>
    <fieldset>
      <legend>故障注入</legend>
      <label><input type="radio" name="research-fault" value="none" checked /> 安全默认</label>
      <label><input type="radio" name="research-fault" value="missing-values" /> 缺失值：先回到数据检查</label>
      <label><input type="radio" name="research-fault" value="stale-memory" /> 过期 Memory：确认版本与寿命</label>
      <label><input type="radio" name="research-fault" value="mcp-denied" /> MCP 未获确认：保持只读</label>
    </fieldset>
    <button type="button" class="research-capstone-lab__run" data-research-run>运行确定性实验</button>
  </div>

  <div class="research-capstone-lab__output" aria-live="polite">
    <div class="research-capstone-lab__summary" data-research-summary>尚未运行</div>
    <ul class="research-capstone-lab__checks" data-research-checks></ul>
    <p class="research-capstone-lab__boundary" data-research-boundary>
      证据只保留固定枚举；真实客户端、API、MCP 服务和研究数据需要另行核验。
    </p>
    <button type="button" class="research-capstone-lab__export" data-research-export disabled>
      导出匿名 evidence
    </button>
  </div>
</section>

<script>
  import {
    buildResearchEvidence,
    buildResearchRun,
    summarizeResearchRun,
  } from "../lib/research-capstone.mjs";

  const root = document.querySelector("[data-research-capstone]");
  if (root) {
    const summary = root.querySelector("[data-research-summary]");
    const checks = root.querySelector("[data-research-checks]");
    const boundary = root.querySelector("[data-research-boundary]");
    const runButton = root.querySelector("[data-research-run]");
    const exportButton = root.querySelector("[data-research-export]");
    let latestEvidence = null;

    const selected = (name) => root.querySelector(`input[name="${name}"]:checked`)?.value;
    const render = () => {
      const run = buildResearchRun({ input: selected("research-input"), fault: selected("research-fault") });
      latestEvidence = buildResearchEvidence(run);
      const result = summarizeResearchRun(run);
      if (summary) {
        summary.textContent = `${result.label} · ${result.result === "passed" ? "可交付" : "需要恢复"}`;
        summary.dataset.result = result.result;
      }
      if (checks) {
        checks.replaceChildren(
          ...run.checks.map((check) => {
            const item = document.createElement("li");
            item.dataset.result = check.result;
            item.textContent = `${check.result === "passed" ? "通过" : "待补齐"} · ${check.id}`;
            return item;
          }),
        );
      }
      if (boundary) {
        boundary.textContent = run.fault === "none"
          ? "安全默认：脚本、图表、记录、报告和匿名证据均来自固定合成输入；不代表真实 API 或客户端已经执行。"
          : `故障 ${run.fault} 已注入：先记录失败证据，再按页面提示恢复；夹具不会把不完整交付伪装成通过。`;
      }
      if (exportButton) exportButton.disabled = false;
    };

    runButton?.addEventListener("click", render);
    exportButton?.addEventListener("click", () => {
      if (!latestEvidence) return;
      const blob = new Blob([JSON.stringify(latestEvidence, null, 2)], { type: "application/json" });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = "t23-research-capstone-evidence.json";
      link.click();
      URL.revokeObjectURL(link.href);
    });
    render();
  }
</script>

<style>
  .research-capstone-lab {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1rem;
    background: var(--sl-color-bg-nav);
    padding: 1.2rem;
    margin: 1.5rem 0;
  }
  .research-capstone-lab__intro { max-width: 62rem; }
  .research-capstone-lab .eyebrow {
    color: var(--sl-color-accent-high);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .research-capstone-lab__controls {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 1rem;
  }
  .research-capstone-lab fieldset {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.7rem;
    min-width: 0;
    padding: 0.8rem;
  }
  .research-capstone-lab label {
    display: block;
    margin: 0.55rem 0;
  }
  .research-capstone-lab input { accent-color: var(--sl-color-accent); margin-right: 0.4rem; }
  .research-capstone-lab button {
    border: 1px solid var(--sl-color-accent-high);
    border-radius: 999px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    cursor: pointer;
    font: inherit;
    padding: 0.55rem 0.9rem;
  }
  .research-capstone-lab button:disabled { cursor: not-allowed; opacity: 0.55; }
  .research-capstone-lab__run { align-self: end; justify-self: start; }
  .research-capstone-lab__output {
    border-top: 1px solid var(--sl-color-gray-5);
    margin-top: 1rem;
    padding-top: 1rem;
  }
  .research-capstone-lab__summary { font-weight: 700; margin-bottom: 0.6rem; }
  .research-capstone-lab__summary[data-result="passed"] { color: var(--sl-color-green); }
  .research-capstone-lab__summary[data-result="partial"] { color: var(--sl-color-orange); }
  .research-capstone-lab__checks { columns: 2; list-style: none; margin: 0; padding: 0; }
  .research-capstone-lab__checks li { break-inside: avoid; margin: 0.35rem 0; }
  .research-capstone-lab__checks li[data-result="passed"]::before { content: "✓ "; color: var(--sl-color-green); }
  .research-capstone-lab__checks li[data-result="failed"]::before { content: "! "; color: var(--sl-color-orange); }
  .research-capstone-lab__boundary { color: var(--sl-color-gray-2); font-size: 0.9rem; }
  @media (max-width: 640px) {
    .research-capstone-lab__controls { grid-template-columns: 1fr; }
    .research-capstone-lab__checks { columns: 1; }
  }
</style>
