---
// 自带密钥（BYO-key）对话实验：浏览器直连 OpenAI/Anthropic，密钥只存页面内存。
// 架构决定见 docs/adr/0008-byo-key-browser-direct-experiments.md。
const initialModels: Record<string, string> = {
  openai: "gpt-4o-mini",
  anthropic: "claude-3-5-haiku-latest",
};
---

<section class="byo-key-chat" data-byo-key-chat data-initial-models={JSON.stringify(initialModels)} aria-labelledby="byo-key-title">
  <h3 id="byo-key-title">自带密钥对话实验</h3>

  <fieldset class="byo-mode">
    <legend>实验模式</legend>
    <label><input type="radio" name="byo-mode" value="offline" checked /> 离线演示（默认，零网络、零费用）</label>
    <label><input type="radio" name="byo-mode" value="live" /> 真实调用（输入自己的 API 密钥，费用自理）</label>
  </fieldset>

  <div class="byo-live-controls" data-byo-live-controls hidden>
    <label>
      服务商
      <select data-byo-provider>
        <option value="openai">OpenAI</option>
        <option value="anthropic">Anthropic</option>
      </select>
    </label>
    <label>
      API 密钥（只存本页内存，关闭页面即消失）
      <input type="password" data-byo-key autocomplete="off" placeholder="sk-...（不会上传到课程服务器）" />
    </label>
    <label>
      模型名（易变，以官方模型页为准；核验日期 2026-08-17）
      <input type="text" data-byo-model value="gpt-4o-mini" />
    </label>
  </div>

  <label class="byo-message-label">
    你的消息
    <textarea data-byo-message rows="3">用一句话解释：模型和 Agent 有什么区别？</textarea>
  </label>

  <button type="button" data-byo-send>发送</button>
  <p class="byo-status" role="status" aria-live="polite" data-byo-status>当前为离线演示模式：发送后立即返回本地预置回复，不发出任何网络请求。</p>

  <div class="byo-output" data-byo-output hidden>
    <h4>结果</h4>
    <dl>
      <dt>请求端点</dt>
      <dd data-byo-endpoint>—</dd>
      <dt>模型回复</dt>
      <dd data-byo-reply>—</dd>
      <dt>用量</dt>
      <dd data-byo-usage>—</dd>
      <dt>耗时</dt>
      <dd data-byo-elapsed>—</dd>
    </dl>
  </div>

  <details class="byo-privacy">
    <summary>安全与费用说明（展开阅读）</summary>
    <ul>
      <li>密钥只存在于本页内存：不写 localStorage、不发送到课程服务器、课程无法也不收集它；刷新或关闭页面即消失。</li>
      <li>真实调用的目标只有你选择的服务商官方端点（OpenAI <code>api.openai.com</code> / Anthropic <code>api.anthropic.com</code>），可在浏览器开发者工具 Network 面板自行核实。</li>
      <li>密钥在本机开发者工具中可见：公共电脑勿用；实验完可在服务商控制台随时撤销密钥。</li>
      <li>真实调用按你的账户计费；一次演示对话通常消耗极少量 token，但价格以官方页面为准，课程不代管任何费用。</li>
    </ul>
  </details>

  <noscript>
    <p>本实验需要 JavaScript。不开启 JavaScript 时，请阅读上方文字说明了解 API key 与调用的概念。</p>
  </noscript>
</section>

<script>
  const section = document.querySelector<HTMLElement>("[data-byo-key-chat]");
  const initialModels = JSON.parse(section?.dataset.initialModels ?? "{}") as Record<string, string>;

  const offlineReply = (message: string) =>
    [
      "【离线演示回复】这里没有真实模型——这条回复是页面本地预置的。",
      "",
      `你刚才发出的消息是：「${message}」。`,
      "如果切换到真实调用模式，这句话会连同一段系统指令一起，通过 HTTPS 发给你所选服务商的官方接口，服务商扣费后返回模型生成的回答。",
      "真实模式下你会看到：请求端点、模型回复、token 用量和耗时——这些就是模块 11 里手写 Agent loop 时你要亲手处理的东西。",
    ].join("\n");

  if (section) {
    const modeInputs = Array.from(section.querySelectorAll<HTMLInputElement>('input[name="byo-mode"]'));
    const liveControls = section.querySelector<HTMLElement>("[data-byo-live-controls]");
    const providerSelect = section.querySelector<HTMLSelectElement>("[data-byo-provider]");
    const keyInput = section.querySelector<HTMLInputElement>("[data-byo-key]");
    const modelInput = section.querySelector<HTMLInputElement>("[data-byo-model]");
    const messageInput = section.querySelector<HTMLTextAreaElement>("[data-byo-message]");
    const sendButton = section.querySelector<HTMLButtonElement>("[data-byo-send]");
    const statusEl = section.querySelector<HTMLElement>("[data-byo-status]");
    const outputEl = section.querySelector<HTMLElement>("[data-byo-output]");
    const endpointEl = section.querySelector<HTMLElement>("[data-byo-endpoint]");
    const replyEl = section.querySelector<HTMLElement>("[data-byo-reply]");
    const usageEl = section.querySelector<HTMLElement>("[data-byo-usage]");
    const elapsedEl = section.querySelector<HTMLElement>("[data-byo-elapsed]");

    const isLive = () => modeInputs.some((input) => input.checked && input.value === "live");

    for (const input of modeInputs) {
      input.addEventListener("change", () => {
        if (!liveControls || !statusEl) return;
        liveControls.hidden = !isLive();
        statusEl.textContent = isLive()
          ? "真实调用模式：密钥只在你的浏览器内存中，请求直连服务商官方端点。"
          : "当前为离线演示模式：发送后立即返回本地预置回复，不发出任何网络请求。";
      });
    }
    providerSelect?.addEventListener("change", () => {
      if (modelInput && providerSelect.selectedOptions[0]) {
        modelInput.value = initialModels[providerSelect.value] ?? modelInput.value;
      }
    });

    sendButton?.addEventListener("click", async () => {
      if (!messageInput || !statusEl || !outputEl || !replyEl || !endpointEl || !usageEl || !elapsedEl) return;
      const message = messageInput.value.trim();
      if (!message) {
        statusEl.textContent = "请先输入消息。";
        return;
      }
      if (!isLive()) {
        endpointEl.textContent = "（离线演示：无网络请求）";
        replyEl.textContent = offlineReply(message);
        usageEl.textContent = "0 token（演示）";
        elapsedEl.textContent = "0 ms（演示）";
        outputEl.hidden = false;
        statusEl.textContent = "离线演示完成。切换到真实调用模式可发起真正的模型请求。";
        return;
      }
      const provider = providerSelect?.value ?? "openai";
      const key = keyInput?.value.trim() ?? "";
      const model = modelInput?.value.trim() || initialModels[provider] || "";
      if (!key) {
        statusEl.textContent = "真实调用需要你的 API 密钥；没有密钥也可以停留在离线演示模式完成本课。";
        return;
      }
      const systemPrompt = "你是中文课程《Agent 工程入门》的教学助手。用不超过 120 字的简体中文回答学员问题。";
      sendButton.disabled = true;
      statusEl.textContent = "请求已发出，等待服务商响应……";
      const startedAt = performance.now();
      try {
        let endpoint = "";
        let response: Response;
        if (provider === "anthropic") {
          endpoint = "https://api.anthropic.com/v1/messages";
          response = await fetch(endpoint, {
            method: "POST",
            headers: {
              "content-type": "application/json",
              "x-api-key": key,
              "anthropic-version": "2023-06-01",
              "anthropic-dangerous-direct-browser-access": "true",
            },
            body: JSON.stringify({ model, max_tokens: 500, system: systemPrompt, messages: [{ role: "user", content: message }] }),
          });
        } else {
          endpoint = "https://api.openai.com/v1/chat/completions";
          response = await fetch(endpoint, {
            method: "POST",
            headers: { "content-type": "application/json", authorization: `Bearer ${key}` },
            body: JSON.stringify({ model, max_tokens: 500, messages: [{ role: "system", content: systemPrompt }, { role: "user", content: message }] }),
          });
        }
        const elapsed = Math.round(performance.now() - startedAt);
        endpointEl.textContent = endpoint;
        elapsedEl.textContent = `${elapsed} ms`;
        if (!response.ok) {
          const hint =
            response.status === 401 || response.status === 403
              ? "密钥无效或无权限：检查是否复制完整、是否给该模型授权。"
              : response.status === 429
                ? "速率限制或额度不足：稍后再试或查看账户额度。"
                : `服务商返回 ${response.status}：查看响应了解原因。`;
          replyEl.textContent = hint;
          usageEl.textContent = "—";
          statusEl.textContent = "调用失败（这本身也是有价值的实验数据：真实接口会拒绝坏的输入）。";
        } else {
          const data = (await response.json()) as Record<string, any>;
          const reply =
            provider === "anthropic"
              ? (data.content?.map((block: any) => block.text ?? "").join("") ?? "")
              : (data.choices?.[0]?.message?.content ?? "");
          const usage =
            provider === "anthropic"
              ? `输入 ${data.usage?.input_tokens ?? "?"} / 输出 ${data.usage?.output_tokens ?? "?"} token`
              : `输入 ${data.usage?.prompt_tokens ?? "?"} / 输出 ${data.usage?.completion_tokens ?? "?"} token`;
          replyEl.textContent = String(reply || "（空回复）");
          usageEl.textContent = usage;
          statusEl.textContent = "真实调用成功：以上是服务商返回的原始数据摘要。";
        }
        outputEl.hidden = false;
      } catch (error) {
        endpointEl.textContent = provider === "anthropic" ? "https://api.anthropic.com/v1/messages" : "https://api.openai.com/v1/chat/completions";
        replyEl.textContent = `网络层失败：${error instanceof Error ? error.message : String(error)}（断网、广告拦截器或浏览器扩展都可能造成。）`;
        usageEl.textContent = "—";
        elapsedEl.textContent = "—";
        outputEl.hidden = false;
        statusEl.textContent = "请求没有到达服务商。离线演示模式永远可用。";
      } finally {
        sendButton.disabled = false;
      }
    });
  }
</script>

<style>
  .byo-key-chat { border: 1px solid var(--sl-color-gray-5); border-radius: 8px; padding: 1rem 1.25rem; margin: 1.5rem 0; }
  .byo-mode { display: grid; gap: 0.35rem; margin-bottom: 0.75rem; }
  .byo-live-controls { display: grid; gap: 0.5rem; margin-bottom: 0.75rem; }
  .byo-live-controls[hidden] { display: none; }
  .byo-live-controls label, .byo-message-label { display: grid; gap: 0.25rem; font-weight: 600; }
  .byo-live-controls input, .byo-live-controls select, .byo-message-label textarea {
    font-weight: 400; padding: 0.5rem; border: 1px solid var(--sl-color-gray-5); border-radius: 6px; min-height: 44px;
  }
  .byo-key-chat button { min-height: 44px; padding: 0.5rem 1.25rem; margin: 0.5rem 0; cursor: pointer; }
  .byo-status { min-height: 1.5rem; }
  .byo-output dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.35rem 1rem; margin: 0.5rem 0; }
  .byo-output dt { font-weight: 600; }
  .byo-output dd { margin: 0; white-space: pre-wrap; }
  .byo-privacy { margin-top: 0.75rem; }
  @media (prefers-reduced-motion: no-preference) {
    .byo-output:not([hidden]) { animation: byo-fade-in 200ms ease-out; }
  }
  @keyframes byo-fade-in { from { opacity: 0; } to { opacity: 1; } }
</style>
