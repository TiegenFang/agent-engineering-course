        .contract-heading, .capability-heading, .lessons-heading, .tools-heading { display: block; }
        .contract-grid { grid-template-columns: 1fr 1fr; }
        .contract-cell { min-height: 10rem; }
        .capability-heading p, .lessons-heading p, .tools-heading p { margin-top: 1.2rem; }
        .mode-switch { margin-top: 1.4rem; }
        .capability-workspace { display: block; }
        .layer-tabs { display: flex; overflow-x: auto; }
        .layer-tabs button { min-width: 8rem; min-height: 5.5rem; display: block; padding: 0.75rem; border-right: 1px solid var(--line); border-bottom: 0; }
        .layer-tabs button[aria-selected="true"] { box-shadow: inset 0 -3px 0 var(--amber); }
        .layer-tabs button strong { display: block; margin-top: 0.45rem; font-size: 0.74rem; }
        .layer-tabs button i { display: none; }
        .layer-output, .layer-output-item { min-height: 24rem; }
