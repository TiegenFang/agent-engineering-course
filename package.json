{
  "name": "agent-engineering-course",
  "version": "3.0.0",
  "private": true,
  "workspaces": [
    "site"
  ],
  "scripts": {
    "check": "npm run check --workspace @agent-engineering-course/site",
    "build": "npm run build --workspace @agent-engineering-course/site",
    "test:site": "npm run test --workspace @agent-engineering-course/site",
    "browser:install": "npm run browser:install --workspace @agent-engineering-course/site",
    "test:browser": "npm run test:browser --workspace @agent-engineering-course/site",
    "test:python": "python -m unittest discover -s checker/tests -t checker -v",
    "audit:release": "python scripts/release_audit.py --root . --report .audit/t33-release-audit.md --json-output .audit/t33-release-audit.json",
    "audit:accessibility": "python scripts/accessibility_audit.py --root . --report .audit/t32-accessibility-audit.md --json-output .audit/t32-accessibility-audit.json",
    "checker": "npm run test:python",
    "diff-check": "git diff --check",
    "verify": "npm run test:python && npm run check && npm run build && npm run test:site && npm run test:browser"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/inspector": "2.2.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
