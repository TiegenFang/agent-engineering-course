    {
      "id": "t06-git-safety",
      "title": "模块 0：Git 安全修改与恢复",
      "stage": "alpha",
      "duration_minutes": 60,
      "prerequisites": ["t05-environment"],
      "outcomes": [
        "在一次性练习仓库中完成 status、diff、选择性暂存、提交、分支和历史检查",
        "用 git restore 恢复一次可观察的错误修改，并说明工作区与暂存区的区别",
        "用 .gitignore 和 git check-ignore 排除合成敏感文件，并生成不含路径、凭据和源码的匿名证据"
      ],
      "artifacts": [
        "git-safety-practice（基线、修改、分支、恢复和忽略规则证据）",
        "git-safety-diagnostic.json（仅含状态）",
        "git-safety-evidence.json（匿名 evidence contract）",
        "一份不含身份信息、绝对路径和凭据的预测与恢复记录"
      ],
      "primary_tool": "Git 2.x + PowerShell 7",
