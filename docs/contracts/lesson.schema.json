{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TiegenFang/agent-engineering-course/blob/main/docs/contracts/lesson.schema.json",
  "title": "课程内容契约",
  "type": "object",
  "required": [
    "id",
    "title",
    "stage",
    "duration_minutes",
    "prerequisites",
    "outcomes",
    "artifacts",
    "primary_tool",
    "migration_tool",
    "platforms",
    "versions",
    "verified_on",
    "access",
    "risk",
    "sources",
    "licenses"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "minLength": 1 },
    "duration_minutes": { "type": "integer", "minimum": 1 },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "outcomes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "artifacts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "primary_tool": { "type": "string" },
    "migration_tool": { "type": "string" },
    "platforms": { "type": "object" },
    "versions": { "type": "object" },
    "verified_on": { "type": "string", "format": "date" },
    "access": { "type": "object" },
    "risk": { "type": "object" },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "licenses": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}

